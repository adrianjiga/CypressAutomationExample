{
  "name": "cypress-automation-example",
  "version": "2.0.0",
  "description": "A demo project showcasing Cypress testing capabilities including UI, API, and table interactions with modern patterns.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:ui": "cypress run --expose grepTags=@ui",
    "test:api": "cypress run --expose grepTags=@api",
    "test:webtables": "cypress run --expose grepTags=@webTables",
    "test:smoke": "cypress run --expose grepTags=@smoke",
    "test:all": "cypress run",
    "test:viewport:mobile": "cypress run --expose grepTags=@ui,viewport=mobile",
    "test:viewport:tablet": "cypress run --expose grepTags=@ui,viewport=tablet",
    "test:viewport:desktop": "cypress run --expose viewport=desktop",
    "test:browser:chrome": "cypress run --browser chrome",
    "test:browser:firefox": "cypress run --browser firefox",
    "test:browser:edge": "cypress run --browser edge",
    "test:docker:ui": "docker compose up --build uiTests",
    "test:docker:api": "docker compose up --build apiTests",
    "test:docker:webtables": "docker compose up --build webtablesTests",
    "test:docker:all": "docker compose up --build cypressTests && npm run report:full",
    "docker:clean": "docker compose down --volumes --remove-orphans",
    "lint": "biome check cypress cypress.config.ts",
    "lint:fix": "biome check --write cypress cypress.config.ts",
    "format": "biome format --write cypress cypress.config.ts",
    "format:check": "biome format cypress cypress.config.ts",
    "report:merge": "mochawesome-merge 'reports/*-report.json' -o reports/merged.json",
    "report:generate": "marge reports/merged.json --reportDir reports/final --inline",
    "report:full": "npm run report:merge && npm run report:generate",
    "clean": "rm -rf reports cypress/videos cypress/screenshots node_modules/.cache",
    "clean:reports": "rm -rf reports",
    "typecheck": "tsc --noEmit",
    "test:a11y": "cypress run --expose grepTags=@a11y"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianjiga/CypressAutomationExample"
  },
  "keywords": [
    "cypress",
    "automation",
    "testing",
    "e2e",
    "api-testing",
    "ui-testing",
    "docker",
    "page-object-model",
    "test-data-factory"
  ],
  "author": {
    "name": "Adrian Jiga",
    "email": "jiga.ion.adrian@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@cypress/grep": "^7.0.0",
    "@faker-js/faker": "^10.6.0",
    "cypress": "^16.0.0"
  },
  "overrides": {
    "diff": ">=8.0.3",
    "serialize-javascript": ">=7.0.5",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.5.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cypress-wait-until": "^3.0.2",
    "mochawesome": "^8.0.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "typescript": "^7.0.2",
    "webqualityanalyzer": "github:adrianjiga/WebQualityAnalyzer"
  }
}
