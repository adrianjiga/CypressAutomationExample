{
  "name": "cypress-automation-example",
  "version": "1.0.0",
  "description": "A demo project showcasing Cypress testing capabilities including UI, API, and table interactions.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:ui": "cypress run --env grepTags=@ui",
    "test:api": "cypress run --env grepTags=@api",
    "test:webtables": "cypress run --env grepTags=@webTables",
    "test:all": "cypress run",
    "test:docker:ui": "docker compose up --build ui-tests",
    "test:docker:api": "docker compose up --build api-tests",
    "test:docker:webtables": "docker compose up --build webtables-tests",
    "test:docker:all": "docker compose up --build && npm run docker:report",
    "docker:report": "docker compose up report-generator",
    "docker:clean": "docker compose down --volumes --remove-orphans",
    "lint": "eslint cypress/e2e/**/*.cy.js cypress/support/**/*.js",
    "lint:fix": "eslint cypress/e2e/**/*.cy.js cypress/support/**/*.js --fix",
    "format": "prettier --write \"cypress/{e2e,support}/**/*.js\"",
    "format:check": "prettier --check \"cypress/{e2e,support}/**/*.js\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianjiga/CypressAutomationExample"
  },
  "keywords": [
    "cypress",
    "automation",
    "testing",
    "e2e",
    "api-testing",
    "ui-testing",
    "docker"
  ],
  "author": {
    "name": "Adrian Jiga",
    "email": "jiga.ion.adrian@gmail.com"
  },
  "license": "ISC",
  "dependencies": {
    "@cypress/grep": "^4.1.0",
    "cypress": "^14.4.0",
    "cypress-plugin-api": "^2.11.2"
  },
  "devDependencies": {
    "cypress-wait-until": "^3.0.2",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-cypress": "^5.0.1",
    "globals": "^16.2.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0",
    "prettier": "^3.5.3"
  }
}