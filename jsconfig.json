{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["cypress"],
    "paths": {
      "@pages/*": ["./cypress/pages/*"],
      "@pages": ["./cypress/pages/index.js"],
      "@support/*": ["./cypress/support/*"],
      "@fixtures/*": ["./cypress/fixtures/*"]
    }
  },
  "include": [
    "cypress/**/*.js",
    "cypress/**/*.d.ts",
    "cypress.config.js"
  ],
  "exclude": ["node_modules"]
}